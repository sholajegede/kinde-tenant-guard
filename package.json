{
  "name": "kinde-tenant-guard",
  "version": "0.4.0",
  "description": "Keep each Kinde organization's data separate. Scopes every database query to the signed-in user's active Kinde organization, with PostgreSQL row-level security as the boundary where it exists. Adapters for Drizzle, Prisma and Convex, isolation tests built on kinde-testkit, an ESLint rule, and tenant-safe AI agent tools.",
  "type": "module",
  "license": "MIT",
  "author": "Shola Jegede",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sholajegede/kinde-tenant-guard.git"
  },
  "homepage": "https://github.com/sholajegede/kinde-tenant-guard#readme",
  "bugs": "https://github.com/sholajegede/kinde-tenant-guard/issues",
  "keywords": [
    "kinde",
    "multi-tenant",
    "tenant-isolation",
    "row-level-security",
    "rls",
    "postgres",
    "drizzle",
    "authorization",
    "saas",
    "organizations",
    "prisma",
    "convex",
    "eslint-plugin",
    "ai-agents",
    "testing"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./drizzle": {
      "import": {
        "types": "./dist/drizzle.d.ts",
        "default": "./dist/drizzle.js"
      },
      "require": {
        "types": "./dist/drizzle.d.cts",
        "default": "./dist/drizzle.cjs"
      }
    },
    "./prisma": {
      "import": {
        "types": "./dist/prisma.d.ts",
        "default": "./dist/prisma.js"
      },
      "require": {
        "types": "./dist/prisma.d.cts",
        "default": "./dist/prisma.cjs"
      }
    },
    "./convex": {
      "import": {
        "types": "./dist/convex.d.ts",
        "default": "./dist/convex.js"
      },
      "require": {
        "types": "./dist/convex.d.cts",
        "default": "./dist/convex.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./agents": {
      "import": {
        "types": "./dist/agents.d.ts",
        "default": "./dist/agents.js"
      },
      "require": {
        "types": "./dist/agents.d.cts",
        "default": "./dist/agents.cjs"
      }
    },
    "./eslint": {
      "import": {
        "types": "./dist/eslint.d.ts",
        "default": "./dist/eslint.js"
      },
      "require": {
        "types": "./dist/eslint.d.cts",
        "default": "./dist/eslint.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "generate": "prisma generate --schema test/prisma/schema.prisma && prisma generate --schema test/prisma/sqlite.prisma",
    "typecheck": "npm run generate && tsc --noEmit",
    "test": "npm run generate && vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@prisma/client": ">=7",
    "convex": ">=1.46",
    "drizzle-orm": ">=0.36",
    "kinde-testkit": ">=0.8",
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "convex": {
      "optional": true
    },
    "kinde-testkit": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "dependencies": {
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.2.0",
    "convex": "^1.51.0",
    "convex-test": "^0.0.73",
    "drizzle-orm": "^0.45.4",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "^10.15.0",
    "kinde-testkit": "^0.8.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
