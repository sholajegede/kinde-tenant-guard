generator client {
  provider = "prisma-client"
  output   = "./generated-sqlite"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id       Int       @id @default(autoincrement())
  tenantId String    @map("tenant_id")
  name     String
  invoices Invoice[]

  @@map("projects")
}

model Invoice {
  id        Int     @id @default(autoincrement())
  tenantId  String  @map("tenant_id")
  projectId Int     @map("project_id")
  amount    Int
  project   Project @relation(fields: [projectId], references: [id])

  @@map("invoices")
}
